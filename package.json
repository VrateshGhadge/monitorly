{
  "name": "monitorly",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "npm run db:migrate --workspace=@repo/db",
    "db:studio": "npm run db:studio --workspace=@repo/db",
    "db:migrate:d1": "cd apps/backend && wrangler d1 migrations apply monitorly-db --local",
    "postinstall": "node scripts/ensure-deploy-deps.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/bcryptjs": "^2.4.6",
    "prettier": "^3.7.4",
    "turbo": "^2.9.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260828.1": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "zod": "^4.4.3"
  }
}

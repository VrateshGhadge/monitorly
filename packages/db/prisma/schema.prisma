generator client {
  provider = "prisma-client"
  output   = "./../generated/prisma-client"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())

  email        String   @unique
  passwordHash String
  name         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monitors     Monitor[]
  alerts       Alert[]
}

model Monitor {
  id            String   @id @default(cuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  url           String

  type          String   @default("WEBSITE")
  method        String   @default("GET")

  active        Boolean  @default(true)
  emailAlerts   Boolean  @default(true)

  currentStatus String   @default("UP")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checks        MonitorCheck[]
  alerts        Alert[]

  @@unique([userId, url])
  @@index([userId])
}

model MonitorCheck {
  id           String   @id @default(cuid())

  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  status       String

  statusCode   Int?
  responseTime Int?
  errorMessage String?

  checkedAt    DateTime @default(now())

  @@index([monitorId])
}

model Alert {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  type      String

  message   String

  status    String   @default("SENT")

  createdAt DateTime @default(now())

  @@index([userId])
}

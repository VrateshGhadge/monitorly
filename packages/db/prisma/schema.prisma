generator client {
  provider = "prisma-client"
  output   = "./../generated/prisma-client"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())

  email        String   @unique
  passwordHash String
  name         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monitors     Monitor[]
  alerts       Alert[]
}

model Monitor {
  id            String        @id @default(uuid())

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  url           String

  type          MonitorType   @default(WEBSITE)
  method        HttpMethod    @default(GET)

  active        Boolean       @default(true)
  emailAlerts   Boolean       @default(true)

  currentStatus MonitorStatus @default(UP)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  checks        MonitorCheck[]
  alerts        Alert[]

  @@unique([userId, url])
  @@index([userId])
}

model MonitorCheck {
  id            String        @id @default(uuid())

  monitorId     String
  monitor       Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  status        MonitorStatus

  statusCode    Int?
  responseTime  Int?
  errorMessage  String?

  checkedAt     DateTime      @default(now())

  @@index([monitorId, checkedAt])
}

model Alert {
  id            String       @id @default(uuid())

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  monitorId     String
  monitor       Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  type          AlertType

  message       String

  status        AlertStatus  @default(SENT)

  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}

enum MonitorStatus {
  UP
  DOWN
}

enum MonitorType {
  WEBSITE
  API
}

enum HttpMethod {
  GET
  POST
}

enum AlertType {
  DOWN
  RECOVERY
}

enum AlertStatus {
  SENT
  RESOLVED
}
